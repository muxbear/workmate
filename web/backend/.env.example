# DeepSeek LLM 配置
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DashScope 向量模型配置
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 服务配置
HOST=127.0.0.1
PORT=8001

# ---- Workspace ----
WORKSPACE=

# ---- Database ----
DATABASE_BACKEND=postgres # sqlite | postgres
DATABASE_URL=postgresql+psycopg:://<username>:<password>@<ip>:<port>/<db_name>
DATABASE_PATH=sqlite+aiosqlite:///./<db_path>/<db_name>

# ---- CHECKPOINT ----
CHECKPOINT_BACKEND=postgres # sqlite | postgres
CHECKPOINT_DB_URL=postgresql://ip:port/<db_name>
CHECKPOINT_DB_PATH=./<db_path>/<db_name>

# ---- STORE ----
STORE_BACKEND=postgres # sqlite | postgres
STORE_DB_URL=
STORE_DB_PATH=

# ---- Encryption ----
# Fernet key: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Auto-generated and persisted to .fernet_key if left empty
ENCRYPTION_KEY=

# ---- JWT ----
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ---- OAuth2 客户端授权 ----
# Web 前端通用授权页地址，桌面端/移动端会从该页面完成用户授权
OAUTH2_FRONTEND_URL=http://localhost:5173

# ---- Image Generation ----
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=wan2.7-image-pro
# Image generation HTTP timeout (seconds). Must stay below the desktop MCP
# tool timeout (AI image generation defaults to 240s).
IMAGE_GEN_TIMEOUT_SECONDS=180

# ---- Video Generation (阿里云百炼 wan3.0-video) ----
VIDEO_GEN_API_KEY=
VIDEO_GEN_BASE_URL=
VIDEO_GEN_MODEL=wan3.0-video
VIDEO_GEN_TIMEOUT_SECONDS=240
