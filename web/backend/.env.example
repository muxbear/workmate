# 对话模型（LLM）配置：不再使用环境变量。
# 提供商、api_base、API 密钥与模型列表统一在 Web 端「模型」页面维护
# （providers / ai_models 表），默认对话模型也在该页面显式指定。
# 解析入口见 src/agent/models/resolver.py。

# DashScope 向量模型配置
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 服务配置
HOST=127.0.0.1
PORT=8001
# MCP 广场内置服务的对外基址（客户端要能访问到本服务）。
# 留空按 HOST/PORT 推导；部署到远端时务必配置，否则同步给桌面版/移动端的
# MCP 地址是回环地址、客户端连不上（图像生成 / 视频生成都会不可用）。
MCP_PUBLIC_BASE_URL=

# ---- Workspace ----
WORKSPACE=

# ---- 产物持久化（智能体生成文件的长期存储） ----
# 存储实现：local（宿主磁盘，默认）/ minio（S3 兼容对象存储，策略模式切换）
ARTIFACT_BACKEND=local
# 本地存储根目录，留空则使用 {WORKSPACE}/artifacts
ARTIFACT_ROOT=
# 单文件大小上限（MB，与附件上传上限保持一致）
ARTIFACT_MAX_FILE_MB=100
# 单用户产物总量上限（MB，0 表示不限制）
ARTIFACT_USER_QUOTA_MB=2048
# 产物留存天数（超过后由后台任务清理，0 表示不清理）
ARTIFACT_RETENTION_DAYS=30
# 留存期清理任务执行间隔（秒）
ARTIFACT_GC_INTERVAL_SECONDS=3600

# MinIO 对象存储（ARTIFACT_BACKEND=minio 时必填 endpoint / access key / secret key）
ARTIFACT_MINIO_ENDPOINT=
ARTIFACT_MINIO_ACCESS_KEY=
ARTIFACT_MINIO_SECRET_KEY=
ARTIFACT_MINIO_BUCKET=ke-work-artifacts
ARTIFACT_MINIO_SECURE=false
ARTIFACT_MINIO_REGION=

# 交付目录：智能体直写 /artifacts/ 的文件在宿主上的 staging 根目录，留空则使用 {WORKSPACE}/artifacts_agent
ARTIFACT_AGENT_ROOT=

# ---- 素材代理下载（download_asset：配图与成片，由后端进程下载，沙箱不出网） ----
# 单次请求超时（秒）与单文件上限（MB）；图片按此上限约束
ARTIFACT_FETCH_TIMEOUT_SECONDS=60
ARTIFACT_FETCH_MAX_MB=100
# 视频成片单独的超时与上限（视频体积大、下载慢，需放宽）
ARTIFACT_FETCH_VIDEO_TIMEOUT_SECONDS=300
ARTIFACT_FETCH_VIDEO_MAX_MB=200
# 允许下载的域名白名单（逗号分隔，支持 *.example.com 通配；留空表示不限制）
ARTIFACT_FETCH_ALLOWED_HOSTS=

# ---- Database ----
DATABASE_BACKEND=postgres # sqlite | postgres
DATABASE_URL=postgresql+psycopg:://<username>:<password>@<ip>:<port>/<db_name>
DATABASE_PATH=sqlite+aiosqlite:///./<db_path>/<db_name>

# ---- CHECKPOINT ----
CHECKPOINT_BACKEND=postgres # sqlite | postgres
CHECKPOINT_DB_URL=postgresql://ip:port/<db_name>
CHECKPOINT_DB_PATH=./<db_path>/<db_name>

# ---- STORE ----
STORE_BACKEND=postgres # sqlite | postgres
STORE_DB_URL=
STORE_DB_PATH=

# ---- Encryption ----
# Fernet key: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Auto-generated and persisted to .fernet_key if left empty
ENCRYPTION_KEY=

# ---- JWT ----
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ---- OAuth2 客户端授权 ----
# Web 前端通用授权页地址，桌面端/移动端会从该页面完成用户授权
OAUTH2_FRONTEND_URL=http://localhost:5173

# ---- Image Generation ----
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=wan2.7-image-pro
# Image generation HTTP timeout (seconds). Must stay below the desktop MCP
# tool timeout (AI image generation defaults to 240s).
IMAGE_GEN_TIMEOUT_SECONDS=180

# ---- Video Generation (阿里云百炼 wan3.0-video) ----
VIDEO_GEN_API_KEY=
VIDEO_GEN_BASE_URL=
VIDEO_GEN_MODEL=wan3.0-video
# 单次同步等待视频生成完成的超时（秒）。服务商排队时 240s 常不够；
# 桌面端 MCP 工具超时为 330s（比本值多 30s 网络余量），两侧需配套调整。
VIDEO_GEN_TIMEOUT_SECONDS=300

# ---- OpenSandBox 沙箱 ----
OPENSANDBOX_DOMAIN=http://<opensandbox-host>:18080
OPENSANDBOX_API_KEY=
# 沙箱闲置回收时间（秒）与后台清理线程执行间隔（秒）
SANDBOX_TTL_SECONDS=600
SANDBOX_CLEANUP_INTERVAL=300
SANDBOX_CPU=2
SANDBOX_MEMORY=3Gi
SANDBOX_IDLE_TIMEOUT_MINUTES=10
# 沙箱出网模式：
#   whitelist —— 仅允许访问 SANDBOX_ALLOWED_DOMAINS 内的域名（默认）
#   allow_all —— 沙箱可不受限制地访问网络
#   deny_all  —— 沙箱完全不可访问网络
SANDBOX_NETWORK_MODE=whitelist
# 白名单域名（逗号分隔，仅 whitelist 模式生效）：代码内不再内置默认域名
SANDBOX_ALLOWED_DOMAINS=pypi.org,*.github.com,*.baidu.com

# ---- 知识库 / 向量库 ----
# 迭代 5 T5.7：这些项从 agent 配置迁入 core，因此 .env.{APP_ENV} 的覆盖对它们生效。
# 向量库后端：milvus（默认）| chroma
VECTOR_DB_BACKEND=milvus
# Milvus 连接。**MILVUS_PASSWORD 必须显式配置**：不再回退到出厂口令 root/Milvus，
# 缺失时初始化向量库会直接失败并说明怎么改（或改用 VECTOR_DB_BACKEND=chroma）。
MILVUS_URI=http://localhost:19530
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_DEFAULT_DB=ke_hermes
# Chroma（VECTOR_DB_BACKEND=chroma 时生效）。端口默认 8000——Chroma 服务端自身的
# 默认端口；这里曾用 8001，正好与应用端口（PORT）撞在一起。
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data
# 文档上传根目录；留空则使用 {WORKSPACE}/docs_upload
DOC_UPLOAD_DIR=
# 索引并发上限（同时索引的文档数）
INDEXING_MAX_CONCURRENT=3
# 知识库配额（0 表示不限）。默认放宽——升级时默认收紧会把存量用户直接挡在门外
KB_MAX_PER_USER=0
KB_MAX_DOCS_PER_KB=0
KB_MAX_STORAGE_MB_PER_USER=0
# 单文件大小上限（MB）
KB_MAX_FILE_MB=100
