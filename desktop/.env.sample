# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<Your LangSmith API Key>

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=<Your DeepSeek API Key>

# Web 技能同步
WORKMATE_WEB_API_BASE_URL=http://127.0.0.1:8001
WORKMATE_WEB_FRONTEND_URL=http://localhost:5173
WORKMATE_OAUTH_CLIENT_ID=ke-work-desktop

# 平台内置 MCP 服务的对外基址（云知识库检索等）。
# 留空按 WORKMATE_WEB_API_BASE_URL 推导；后端部署到远端时，填与后端
# MCP_PUBLIC_BASE_URL 相同的值——否则桌面端认不出这是本平台端点，不会携带访问凭据，
# 且远端地址必须为 https（明文不发凭据）。
WORKMATE_MCP_PUBLIC_BASE_URL=

# MCP tool timeout (ms, optional)
# Defaults: 60000 for general MCP servers; 240000 for AI image generation.
# The image generation timeout must stay below the desktop value (default 240s).
MCP_TOOL_TIMEOUT_MS=240000
